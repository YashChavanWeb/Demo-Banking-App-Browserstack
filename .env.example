# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values
# NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# ── Stripe ───────────────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Expo reads EXPO_PUBLIC_ prefixed vars on the client side (no server needed)
EXPO_PUBLIC_STRIPE_PK=pk_test_REPLACE_ME

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ── Neon PostgreSQL ──────────────────────────────────────────────────────────
# Get from https://console.neon.tech → your project → Connection string
PG_SQL_CONNECTION_STRING=postgresql://user:password@host/dbname?sslmode=require

# ── JWT ──────────────────────────────────────────────────────────────────────
# Use a long random string: `openssl rand -hex 64`
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# ── API URL ──────────────────────────────────────────────────────────────────
# Backend base URL (used by Expo client via EXPO_PUBLIC_API_URL)
API_URL=https://your-server.onrender.com
EXPO_PUBLIC_API_URL=https://your-server.onrender.com

# ── Local App (Stocks Server) ────────────────────────────────────────────────
# URL of the local stocks server (local-app/server.js running on port 5000).
# Simulator/emulator: http://localhost:5000
# Physical device on same WiFi: http://<your-machine-LAN-IP>:5000
#   Find your IP: macOS → System Settings → WiFi → Details
#                 Windows → ipconfig | findstr IPv4
EXPO_PUBLIC_LOCAL_APP_URL=http://localhost:5000

# ── Firebase ─────────────────────────────────────────────────────────────────
# Paste the full JSON content of your Firebase service account key here
# (so the server never needs the .json file on disk)
# Get from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
